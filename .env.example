# Database (Supabase PostgreSQL)
# Runtime: pooled connection via PgBouncer (port 6543)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Migrations: direct connection (port 5432)
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# NextAuth (v5 reads AUTH_SECRET; NEXTAUTH_SECRET is still accepted as a fallback)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Priority order for URL resolution: AUTH_URL -> NEXTAUTH_URL -> NEXT_PUBLIC_APP_URL -> VERCEL_URL
# For Vercel Preview deployments, you can omit these to auto-fallback to VERCEL_URL
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public canonical domain for SEO (canonical, sitemap, robots, JSON-LD), e.g. https://quizfree.example.
# Optional on Vercel Production: falls back to VERCEL_PROJECT_PRODUCTION_URL, then AUTH_URL.
# SITE_URL="https://your-domain.example"
# Google Search Console "HTML tag" verification token (content of google-site-verification meta).
# GOOGLE_SITE_VERIFICATION=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="flashcard-media"
# Create this bucket in Supabase Dashboard → Storage (public read for card images)

# Email (Resend) — required in production for password-reset and email-verification mail.
# The sender onboarding@resend.dev only delivers to the Resend account owner; verify a
# domain to mail real users. Leave empty in development: forgot-password returns a
# `devResetUrl` and verification links are printed to the server log instead.
RESEND_API_KEY=""

# Secret for the daily cleanup cron (vercel.json "crons"); Vercel sends it as a Bearer token
CRON_SECRET=""

# Optional: Web Push keys for the daily study reminder (cron /api/cron/study-reminder).
# Generate once with: pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, e.g. mailto:you@example.com (defaults to the site URL)
VAPID_SUBJECT=""

# Optional: bundle analysis
# ANALYZE=true

# MotAPI (OpenAI-compatible) — AI set generation and the guide chat. Required for both.
# Free tier: 2M tokens/day, 20M/month, resets 07:00 Vietnam time, and at most 2 requests in
# flight per key (a 3rd gets 429 free_tier_concurrency).
MOTAPI_KEY=""
# MOTAPI_BASE_URL="https://motapis.com/v1"   # default when unset
# Ordered model lists (comma-separated). Each request calls one model at a time and
# switches to the next on any error, at most 3 calls, no retries. Defaults live in
# src/config/motapi-env.ts. Avoid claude-sonnet-4-6, grok-4.6, claude-sonnet-5, hy3, hy4-preview.
# MOTAPI_SET_MODELS="deepseek-v4-flash,kimi-k3.1-pro,claude-sonnet-5-5"
# MOTAPI_CHAT_MODELS="kimi-k3.1-pro,deepseek-v4-flash,minimax-m3"

# E2E (Playwright) — optional disposable database; specs create users and sets that are
# never cleaned up. Without it they write to DATABASE_URL above.
# E2E_DATABASE_URL="postgresql://user:password@host:5432/postgres_e2e"
