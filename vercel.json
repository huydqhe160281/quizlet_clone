{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "prisma generate && node scripts/vercel-migrate.mjs && next build",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/study-reminder",
      "schedule": "0 13 * * *"
    }
  ]
}
